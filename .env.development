# npm run dev  (local). This app runs on :5173, zodu Attendance on :5174, and
# the API gateway (zodu-merged-backend) on :5001, so the shared sign-in cookie
# works (same site: localhost). To point at another API just for you, put
# VITE_API_BASE_URL in .env.development.local (not committed).
VITE_API_BASE_URL=http://localhost:5001
VITE_ATTENDANCE_URL=http://localhost:5174
